# jobscout backend settings. Copy to .env and fill in. Never commit .env.
# Relative paths are resolved against the backend/ folder.

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/jobscout

# ---------------------------------------------------------------- secrets
# Encrypts stored LinkedIn and Gmail passwords. Generate with: jobscout keygen
FERNET_KEY=
# Shared secret between the Next.js server and this API; must equal INTERNAL_API_KEY in frontend/.env.local.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# ---------------------------------------------------------------- web
# true when served over HTTPS (production): the session cookie is then never sent over plain http
COOKIE_SECURE=false
# Browser-based jobs (LinkedIn searches/logins) allowed at once across all users
MAX_BROWSER_JOBS=2

# ---------------------------------------------------------------- AI (used to write emails)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_RPM=8
# Optional ordered list of provider:model, tried in turn when one runs out of quota (overrides the GEMINI_* models).
# Providers: google_genai, openai, anthropic, groq, mistralai, ollama. Extras: pip install -e ".[openai]" etc.
# LLM_MODELS=google_genai:gemini-3.5-flash,groq:llama-3.3-70b-versatile
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# false = searches use local rules only; true = AI post analysis for paid users
AI_EXTRACTION=false

# ---------------------------------------------------------------- email
# Per-user Gmail senders are set in the UI. These are defaults and the CLI fallback sender.
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_NAME=
DAILY_EMAIL_CAP=50
EMAIL_MIN_DELAY=30
EMAIL_MAX_DELAY=90
MAX_SEND_ATTEMPTS=3
RESUME_PATH=
PROFILE_PATH=PROFILE.md

# ---------------------------------------------------------------- scraping
# Country for phone numbers written without a +country code (ISO code: IN, US, GB, ...)
DEFAULT_PHONE_REGION=IN
# Keep false: a visible browser is less likely to be flagged and lets you finish CAPTCHA/OTP checks
HEADLESS=false
