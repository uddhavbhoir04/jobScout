# jobscout frontend settings. Copy to .env.local and fill in. Never commit .env.local.
# Both values are server-only: never prefix them with NEXT_PUBLIC_.

# Where the private Python API runs (only the Next.js server talks to it)
BACKEND_URL=http://127.0.0.1:8000

# Must equal INTERNAL_API_KEY in backend/.env
INTERNAL_API_KEY=
